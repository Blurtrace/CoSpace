# =============================================================================
# CoSpace — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a `.env` para el entorno local. NUNCA hagas commit de `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de Datos — PostgreSQL / Supabase
# Ámbito: Ambos (Local y Vercel)
# Propósito: Cadena de conexión URI a la base de datos PostgreSQL alojada en Supabase.
# Formato: postgresql://[usuario]:[password]@[host-pooler]:5432/[db_name]?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[tu-proyecto-ref]:tu_password_aqui@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Autenticación JWT — Secretos de Firma de Tokens
# Ámbito: Ambos (Local y Vercel)
# Propósito: Claves secretas de alta entropía para firmar tokens JWT en cookies httpOnly.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=tu_secreto_hexadecimal_aleatorio_minimo_64_caracteres_para_access_token
JWT_REFRESH_SECRET=tu_secreto_hexadecimal_aleatorio_minimo_64_caracteres_para_refresh_token

# -----------------------------------------------------------------------------
# Configuración de Cookies
# Ámbito: Ambos (Local y Vercel)
# Propósito: Seguridad y alcance de las cookies de sesión httpOnly.
# COOKIE_SECURE: "false" para HTTP local; "true" para entornos HTTPS (Vercel).
# COOKIE_SAME_SITE: "lax" (recomendado) o "strict".
# -----------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Semilla Inicial (Seed) — Solo Entorno de Desarrollo / Setup
# Ámbito: Solo Local (Ejecución de `npm run seed`)
# Propósito: Credenciales para crear el usuario administrador inicial idempotente.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cospacex.local
SEED_ADMIN_PASSWORD=AdminPassword123!

# -----------------------------------------------------------------------------
# Aplicación — Variables Públicas (Accesibles en el navegador)
# Ámbito: Ambos (Local y Vercel)
# Propósito: URL base pública del sitio web.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
