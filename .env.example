# =============================================================================
# CoSpace — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a `.env` para el entorno local. NUNCA hagas commit de `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de Datos — PostgreSQL / Supabase
# Ámbito: Local y Vercel
# Propósito: Cadena de conexión URI a PostgreSQL alojada en Supabase.
# Recomendación para Serverless (Vercel): Usar el Pooler en modo Transacción (puerto 6543)
# Formato: postgresql://postgres.[project-ref]:[encoded-password]@[pooler-host]:6543/postgres?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[tu-proyecto-ref]:tu_password_aqui@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------------------
# Autenticación JWT — Secretos de Firma de Tokens
# Ámbito: Local y Vercel
# Propósito: Claves secretas de alta entropía para firmar tokens JWT (HMAC-SHA256).
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=tu_secreto_hexadecimal_aleatorio_minimo_64_caracteres_para_access_token
JWT_REFRESH_SECRET=tu_secreto_hexadecimal_aleatorio_minimo_64_caracteres_para_refresh_token

# -----------------------------------------------------------------------------
# Configuración de Cookies
# Ámbito: Local y Vercel
# COOKIE_SECURE: "false" en desarrollo HTTP local; "true" en entornos HTTPS (Vercel).
# COOKIE_SAME_SITE: "lax" (estándar recomendado) o "strict".
# -----------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Semilla Inicial (Seed) — Solo Entorno de Desarrollo / Setup inicial
# Ámbito: Solo Local (Ejecución de `npm run seed`)
# Propósito: Credenciales para crear el usuario administrador inicial idempotente.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cospacex.local
SEED_ADMIN_PASSWORD=AdminPassword123!

# -----------------------------------------------------------------------------
# Aplicación — Variables Públicas (Accesibles en el cliente)
# Ámbito: Local y Vercel
# Propósito: URL base pública del sitio web.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
